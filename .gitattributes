# Normalize line endings to LF in the repo and working tree.
# Keeps Prettier (--check expects LF) consistent across Windows/macOS/Linux and CI.
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
