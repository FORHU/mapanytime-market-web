# ─────────────────────────────────────────────────────────────────────────────
# FAOS Next.js Template — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit .env.local to source control.
#
# All variables are validated by Zod at startup (src/shared/lib/env.ts).
# The app will throw a descriptive error if a required variable is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of your backend REST API. Required.
# Example: http://localhost:3001 (local dev) | https://api.yourapp.com (prod)
NEXT_PUBLIC_API_URL=http://192.168.1.176:4002

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical public URL of this frontend. Used for OG tags and sitemap.ts.
# Optional in development, required in production.
# Example: https://yourapp.com
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# ── App Environment ───────────────────────────────────────────────────────────
# Drives feature flag defaults and logging behavior.
# Must be one of: development | staging | production
NEXT_PUBLIC_APP_ENV=development

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoianVuZ2t3YW5zaGluIiwiYSI6ImNtcW9xcGE2aDA1d2wycXF2cXFzdG14bWcifQ.HR1a5C0MxCY4M0f1yEt6-A


# AWS Configuration Credentials
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Separate buckets for security compliance
NEXT_PUBLIC_AWS_S3_PUBLIC_BUCKET=mapanytime-public-assets
AWS_S3_PRIVATE_BUCKET=mapanytime-private-documents