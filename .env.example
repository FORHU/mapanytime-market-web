# ─────────────────────────────────────────────────────────────────────────────
# FAOS Next.js Template — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit .env.local to source control.
#
# All variables are validated by Zod at startup (src/shared/lib/env.ts).
# The app will throw a descriptive error if a required variable is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of your backend REST API. Required.
# Example: http://localhost:4002 (local dev) | https://api.yourapp.com (prod)
NEXT_PUBLIC_API_URL=http://localhost:4002

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical public URL of this frontend. Used for OG tags and sitemap.ts.
# Optional in development, required in production.
# The dev server runs on port 4000 (`pnpm dev`); the Docker image serves 3000.
# Example: https://yourapp.com
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# ── Realtime ──────────────────────────────────────────────────────────────────
# Socket.IO server — hosted by the API process, so same origin as
# NEXT_PUBLIC_API_URL. Inlined at build time; must be set as a Docker build arg.
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:4002

# ── App Environment ───────────────────────────────────────────────────────────
# Drives feature flag defaults and logging behavior.
# Must be one of: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Public (pk.*) token — inlined into the bundle and visible to anyone. Restrict
# it by URL in the Mapbox account so the quota can't be spent by others.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoianVuZ2t3YW5zaGluIiwiYSI6ImNtcW9xcGE2aDA1d2wycXF2cXFzdG14bWcifQ.HR1a5C0MxCY4M0f1yEt6-A

# ── No AWS credentials ────────────────────────────────────────────────────────
# The web holds no AWS access of its own. File uploads are presigned by the API
# (GET /api/v1/file-uploads/presigned-url) and PUT straight to S3 from the
# browser, so nothing here needs a bucket name, region, or key pair.